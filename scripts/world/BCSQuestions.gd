## Questions come out of a shuffled bag: none repeats until every one has been asked once.
static var _bag: Array = []

static func pick(rng: RandomNumberGenerator, avoid: int = -1) -> int:
	if _bag.is_empty():
		for i in QUESTIONS.size():
			_bag.append(i)
		for i in range(_bag.size() - 1, 0, -1):
			var j := rng.randi_range(0, i)
			var tmp: int = _bag[i]
			_bag[i] = _bag[j]
			_bag[j] = tmp
	var q: int = _bag.pop_back()
	if q == avoid and not _bag.is_empty():
		var q2: int = _bag.pop_back()
		_bag.push_front(q)
		q = q2
	return q
